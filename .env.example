# ==========================================
# RENDER (Backend Environment Variables)
# ==========================================
# Supabase PostgreSQL Connection String (from Supabase Project Settings -> Database -> Connection URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Allowed frontend origin (Vercel deployment URL)
FRONTEND_ORIGIN=https://your-frontend-app.vercel.app

# Port is automatically assigned by Render ($PORT)
PORT=8000

# ==========================================
# VERCEL (Frontend Environment Variables)
# ==========================================
# Render Backend URL (without trailing slash)
VITE_API_URL=https://your-backend-app.onrender.com
